# СоцНавигаторAI — конфигурация GigaChat
AI_TIMEOUT_SECONDS=60

# Долгоживущий Authorization Key из кабинета GigaChat API.
# Временный access_token приложение получает само через OAuth и хранит только в памяти.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Для демонстрационного контура можно оставить false.
# Для production желательно установить сертификаты и включить проверку SSL.
GIGACHAT_VERIFY_SSL=false
