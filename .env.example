# SocPulse MVP uses only GigaChat.
AI_TIMEOUT_SECONDS=60

# Recommended: Authorization key from the GigaChat API project cabinet.
# The app will request a short-lived access token and cache it.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Compatibility with our earlier setup: you can provide an already issued token.
# GIGACHAT_ACCESS_TOKEN takes precedence; GC_TOKEN is also accepted.
GIGACHAT_ACCESS_TOKEN=
GC_TOKEN=

# We previously used GigaChat-2-Max for this type of analytical task.
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# For a quick local demo we used SSL verification disabled.
# For a production deployment, install the required certificates and set this to true.
GIGACHAT_VERIFY_SSL=false
